Output demo.gif
Set FontSize 13
Set Width 1200
Set Height 700
Set Theme "Dracula"
Set TypingSpeed 80ms

Type "go run ."
Enter
Sleep 4s

# Switch to Processes tab
Type "2"
Sleep 2s

# Navigate processes
Down
Down
Down
Sleep 1s

# Sort by memory
Type "m"
Sleep 1.5s

# Sort by PID
Type "p"
Sleep 1.5s

# Back to CPU sort
Type "c"
Sleep 1s

# Cycle theme
Type "t"
Sleep 1.5s
Type "t"
Sleep 1.5s

# Open help
Type "?"
Sleep 2.5s

# Close help
Type "?"
Sleep 1s

# Switch to Network tab
Type "3"
Sleep 2s

# Back to Overview
Type "1"
Sleep 2s

# Pause
Type " "
Sleep 1.5s

# Resume
Type " "
Sleep 1s

# Quit
Type "q"
